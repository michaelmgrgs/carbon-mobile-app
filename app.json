{
  "expo": {
    "name": "Carbon",
    "slug": "carbon-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141514",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#141514"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.carbon.gym",
      "infoPlist": {
        "NSCameraUsageDescription": "Carbon needs your camera to scan the check-in QR code at the front desk."
      }
    },
    "android": {
      "package": "com.carbon.gym",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#141514"
      },
      "permissions": ["CAMERA", "NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Carbon needs your camera to scan the check-in QR code."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#D6362F"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://your-carbon-backend.example.com/api/mobile"
    }
  }
}
