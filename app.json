{
  "expo": {
    "name": "Carbon",
    "slug": "carbon-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141514",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#141514"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.carbon.gym",
      "infoPlist": {
        "NSCameraUsageDescription": "Carbon needs your camera to scan the check-in QR code at the front desk.",
        "NSFaceIDUsageDescription": "Carbon uses Face ID so you can log in quickly and securely.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.carbon.gym",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141514"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Carbon needs your camera to scan the check-in QR code."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D6362F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Carbon uses Face ID so you can log in quickly and securely."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://carbon-app-i2s42.ondigitalocean.app/api/mobile"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
